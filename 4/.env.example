# Demo 4 no tiene .env propio: reutiliza ../1/.env (misma infraestructura Docker que las
# demos 1/2/3 -- Postgres, OPENROUTER_API_KEY). Este fichero solo documenta qué variables lee,
# igual que 1/.env.example documenta las de n8n.

# --- Ya deberían existir en ../1/.env ---
# DB_POSTGRESDB_PASSWORD=...   # contraseña de Postgres (compartida)
# OPENROUTER_API_KEY=...       # las demos 1-3 la leen de la credencial de n8n, no de .env;
                                # añádela a ../1/.env para poder ejecutar procesar_facturas.py
                                # SIN --sin-llm.

# --- Propias de la Demo 4 ---
FACTURAS_CONFIANZA_UMBRAL=0.7   # por debajo de min(confianza_campos), la factura va a cola
FACTURAS_MODELO=dots-studio/dots-3-note-preview:free   # via OpenRouter, servido por
                                                        # AtlasCloud (no un pool
                                                        # compartido), multimodal --
                                                        # cubre f10 mas adelante.
FACTURAS_MODELO_GOOGLE=gemma-4-31b-it   # fallback directo a la API de Google si falla OpenRouter
                                         # (red, 403/404, respuesta vacía); usa GEMINI_API_KEY
