FROM python:3.13-slim
WORKDIR /app
RUN pip install --no-cache-dir "langgraph-cli[inmem]" langgraph openai psycopg2-binary pdfplumber requests
COPY grafo_facturas.py validaciones.py langgraph.json ./
EXPOSE 2024
CMD ["langgraph", "dev", "--host", "0.0.0.0", "--port", "2024", "--no-browser", "--allow-blocking"]
