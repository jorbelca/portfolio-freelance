# La Demo 5 no tiene .env propio: reutiliza ../1/.env (misma infraestructura Docker que las
# demos 1-4 -- Postgres, OPENROUTER_API_KEY). Este fichero solo documenta qué variables lee.

# --- Ya deberían existir en ../1/.env ---
# DB_POSTGRESDB_PASSWORD=...   # contraseña de Postgres (compartida)
# OPENROUTER_API_KEY=...       # añádela a ../1/.env para ejecutar procesar_leads.py SIN --sin-llm

# --- Propias de la Demo 5 ---
LEADS_CONFIANZA_UMBRAL=0.7     # por debajo, el lead va a cola (R15)
LEADS_MODELO=dots-studio/dots-3-note-preview:free   # vía OpenRouter (AtlasCloud, no pool compartido)
# SALTAR_INVESTIGACION=1       # inyecta ficha + señales del dataset en vez de correr el bucle
                                # ReAct -- eval reproducible (patrón --sin-llm de la Demo 4)

# --- Postgres (para procesar_leads.py; mismas que la Demo 4) ---
# PGHOST=127.0.0.1  PGPORT=5432  PGDATABASE=n8n  PGUSER=n8n_user  PGPASSWORD=...
