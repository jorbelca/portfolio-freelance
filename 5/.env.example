# La Demo 5 no tiene .env propio: reutiliza ../1/.env (misma infraestructura Docker que las
# demos 1-4 -- Postgres, OPENROUTER_API_KEY). Este fichero solo documenta qué variables lee.

# --- Ya deberían existir en ../1/.env ---
# DB_POSTGRESDB_PASSWORD=...   # contraseña de Postgres (compartida)
# OPENROUTER_API_KEY=...       # añádela a ../1/.env para ejecutar procesar_leads.py SIN --sin-llm

# --- Propias de la Demo 5 ---
LEADS_CONFIANZA_UMBRAL=0.7     # por debajo, el lead va a cola (R15)
LEADS_MODELO=gemini-3.6-flash   # vía Gemini de AI Studio (por defecto en tablero.sh)
                                          # cada lead caliente/tibio = 2 llamadas: cualificación + segunda lectura

# Corrida de referencia (el número del vídeo): el pool :free de OpenRouter varía entre llamadas
# idénticas a temp 0 -> l21-l24 fallan de forma aleatoria. Alternativa gratis y estable: la API
# de Gemini de Google AI Studio (https://aistudio.google.com/apikey) -- cuota propia, no un pool
# compartido. Endpoint compatible con OpenAI, así que solo cambian 3 variables:
#   LEADS_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LEADS_LLM_API_KEY=<clave de AI Studio>
#   LEADS_MODELO=gemini-3.6-flash
# Tier gratis ~10 req/min -> subir LEADS_REINTENTOS a 6 para que el backoff absorba los 429.
# OJO: el límite diario del tier gratis es POR MODELO (~20-50 req/día según modelo). La corrida
# de los 30 gasta ~60 llamadas -> si se agota, todo cae a `sin_cualificar`. Si pasa, corre la eval
# por OpenRouter (LEADS_OPENROUTER=1) y deja Gemini para las tomas sueltas.
# tablero.sh valida el modelo al arrancar (existe en el catálogo + 1 llamada de humo si no es
# el default) para no descubrir el 429 a los 15 casos.

LEADS_MAX_TOKENS=8192          # margen para el scratchpad; algunos :free truncan el JSON con menos
LEADS_TIMEOUT=120              # segundos por llamada
LEADS_REINTENTOS=3             # respuesta vacía / 429 intermitente; reintento con backoff (6 con Gemini free)
# SALTAR_INVESTIGACION=1       # inyecta señales del dataset en vez de correr el bucle ReAct
                                # (la ficha siempre del mock) -- eval reproducible
LEADS_MAX_BUSQUEDAS=3           # tope de queries del bucle ReAct de investigacion_agente
LEADS_FOLLOWUP=3 días           # texto del followup sugerido (V2), sin integración de calendario

# --- V2: borrador de email en GreenMail (SMTP de ../1/docker-compose.yml) ---
LEADS_SMTP_HOST=127.0.0.1       # 'greenmail' si el grafo corre dentro del compose
LEADS_SMTP_PORT=3025            # sin servidor -> el borrador igual queda en la cola de revisión

# --- CRM ---
# La BANDEJA (base `crm` + tabla + card "Bandeja del CRM" en el tablero) no necesita nada:
# tablero.sh siempre crea la base `crm` y exporta CRM_PGDATABASE=crm.
# NocoDB (la UI tipo CRM, http://127.0.0.1:8091) SÍ exige un admin -> solo si pones esto en
# ../1/.env. Sin ello, la bandeja del tablero funciona igual, solo falta la UI bonita.
# Con admin, tablero.sh crea la base `nocodb` (metadatos de NocoDB) y conecta `crm` como
# data source vía API (crm-nocodb-init.sh, idempotente).
# NC_ADMIN_PASSWORD=...          # NocoDB exige 8+ car., 1 mayús, 1 número, 1 símbolo
# NC_ADMIN_EMAIL=demo@nubeforge.local

# --- Postgres (para procesar_leads.py; mismas que la Demo 4) ---
# PGHOST=127.0.0.1  PGPORT=5432  PGDATABASE=n8n  PGUSER=n8n_user  PGPASSWORD=...
