# Demo 6 no tiene .env propio: reutiliza ../1/.env (misma infraestructura Docker que
# las demos 1-5 -- Postgres, OPENROUTER_API_KEY / GEMINI_API_KEY). Este fichero solo
# documenta qué variables lee.

# --- Ya deberían existir en ../1/.env ---
# DB_POSTGRESDB_PASSWORD=...   # contraseña de Postgres (compartida)
# OPENROUTER_API_KEY=...       # necesaria para el modo real de eval/run_eval.py y el agente
# GEMINI_API_KEY=...           # fallback directo a la API de Google (día X)

# --- Propias de la Demo 6 (día X en adelante) ---
RECLAMACIONES_MODELO=google/gemma-4-31b-it:free   # via OpenRouter; solo clasifica causa
                                                   # + extrae hechos, no computa importes
RECLAMACIONES_MODELO_GOOGLE=gemma-4-31b-it         # fallback directo si OpenRouter falla
