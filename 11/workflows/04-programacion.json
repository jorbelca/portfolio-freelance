{
  "id": "empleoSchedule04",
  "name": "Empleo - comprobar programación cada minuto",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Madrid"
  },
  "nodes": [
    {
      "id": "clock",
      "name": "Cada minuto",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "tick",
      "name": "Comprobar programación",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        280,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3210/api/workflow/schedule/tick",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": 20000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "empleoPanelHeader",
          "name": "Empleo · puente local"
        }
      }
    }
  ],
  "connections": {
    "Cada minuto": {
      "main": [
        [
          {
            "node": "Comprobar programación",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
