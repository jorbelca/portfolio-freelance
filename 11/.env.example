# URL de Neon con sslmode=verify-full. Mantener la verificación TLS.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
PORT=3210
# Secreto compartido con la credencial Header Auth de n8n.
N8N_TOKEN=
N8N_URL=http://127.0.0.1:5678
# Secreto MCP independiente de N8N_TOKEN; al menos 32 caracteres aleatorios.
MCP_TOKEN=
# Opcional en stdio; por defecto http://127.0.0.1:PORT.
EMPLEO_API_URL=
# 1 expone solo consultas en stdio; 0 permite herramientas de cambio.
EMPLEO_MCP_READ_ONLY=0
# Dejar vacío para usar el modelo predeterminado de Codex.
CODEX_MODEL=
CODEX_TIMEOUT_MS=120000

# Solo para el motor API de OpenAI. Nunca se envía al navegador ni a n8n.
OPENAI_API_KEY=
