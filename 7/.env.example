# La Demo 7 no tiene .env propio para Postgres: reutiliza ../1/.env (mismo Docker que
# las demos 1-6 -- Postgres). Este fichero solo documenta qué variables lee.

# --- Ya deberían existir en ../1/.env ---
# DB_POSTGRESDB_PASSWORD=...   # contraseña de Postgres (compartida)

# --- Postgres (para generar_datos.py e ingesta.py) ---
# PGHOST=127.0.0.1  PGPORT=5432  PGDATABASE=n8n  PGUSER=n8n_user  PGPASSWORD=...

# --- ERP falso ---
ERP_API_KEY=demo-key-2026
ERP_PORT=8070
ERP_URL=http://127.0.0.1:8070   # cambia a http://<IP-host>:8070 al llamar desde la VM

# --- Informe (opcional, ver §5 del plan) ---
INFORME_LLM=0                    # 1 solo para el párrafo de resumen sobre números ya calculados
