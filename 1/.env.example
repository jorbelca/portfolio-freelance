# Plantilla de variables de entorno. Copia a .env y sustituye los marcadores.
# Ningún valor real de este fichero debe subirse al repositorio.

# --- Postgres (pgvector) ---
DB_POSTGRESDB_PASSWORD=secure_password_change_me

# --- Modelo de lenguaje ---
# Los embeddings de la busqueda de estatutos usan Gemini (los vectores de
# documentos_comunidad se generaron con ese modelo y esa dimension).
GEMINI_API_KEY=change_me
# El clasificador de B1 usa OpenRouter, que en el free tier da mas cuota que Gemini.
# La key se pega en la credencial 'OpenRouter' de n8n, no la lee el contenedor:
# esta aqui solo para documentar que hace falta.
OPENROUTER_API_KEY=change_me

# --- Correo de pruebas: GreenMail (ver docker-compose.yml) ---
# SMTP 3025 e IMAP 3143; webmail Roundcube en http://localhost:8081
SMTP_HOST=greenmail
SMTP_PORT=3025
IMAP_HOST=greenmail
IMAP_PORT=3143
IMAP_USER=change_me
IMAP_PASSWORD=change_me

# --- Triage ---
TRIAGE_CONFIANZA_UMBRAL=0.7   # por debajo de este valor, el correo va a la cola de revisión humana
TRIAGE_CONFIANZA_UMBRAL_RUIDO=0.9   # umbral solo para 'ruido': archivar es la única rama sin rastro

# --- Demo B: incidencias en fincas (misma pila, ver ../2/README.md) ---
FINCAS_CONFIANZA_UMBRAL=0.7      # por debajo, la incidencia va a la cola del administrador
FINCAS_UMBRAL_SIN_PLAZO=0.9      # afirmar que NO corre ningún plazo exige más confianza que afirmar que sí
# La ventana de deduplicación (72 h) no se configura aquí: vive en buscar_incidencia_raiz(),
# en 2/init-fincas-tables.sql. Una sola fuente de verdad.
