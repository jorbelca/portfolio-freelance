{
  "name": "Demo 2 - RAG con Citas",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Subir documento del despacho",
        "formFields": {
          "values": [
            {
              "fieldLabel": "documento_pdf",
              "fieldType": "file",
              "multipleFiles": true,
              "acceptFileTypes": ".pdf",
              "requiredField": true
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ],
      "id": "form-upload",
      "name": "Subir Documento",
      "webhookId": "demo1-upload"
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const key of Object.keys($input.item.binary || {})) {\n  const bin = $input.item.binary[key];\n  const nombre = (bin.fileName || key).replace(/\\.pdf$/i, '');\n  out.push({ json: { documento: nombre }, binary: { [key]: bin } });\n}\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "id": "split-files",
      "name": "Separar Archivos (1 item por PDF)"
    },
    {
      "parameters": {
        "operation": "pdf",
        "binaryPropertyName": "={{ Object.keys($binary)[0] }}",
        "options": {
          "joinPages": false
        }
      },
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        440,
        0
      ],
      "id": "extract-pdf",
      "name": "Extraer Texto PDF"
    },
    {
      "parameters": {
        "jsCode": "// Recibe 1 item por PDF (el array items[i].json.text, uno por página, gracias a\n// joinPages:false en \"Extraer Texto PDF\") y emite N items, uno por página real.\n//\n// Por qué itemMatching(i) y no $('Separar Archivos...').item: en modo \"Run Once for\n// All Items\" (el modo por defecto de este nodo, sin 'mode' explícito) $('Nodo').item\n// e $input.item resuelven SIEMPRE contra el item 0 del nodo actual — no son sensibles\n// a en qué vuelta del bucle estás. Es un hecho verificado leyendo el código fuente de\n// n8n (workflow-data-proxy.js: that.itemIndex viene fijado a 0 en runForAllItems /\n// JsTaskRunnerSandbox.runCodeAllItems). El formulario de subida admite multipleFiles,\n// así que con 2+ PDF en la misma ejecución, \".item\" pegaría el documento del PRIMER\n// PDF a las páginas de todos los demás — el mismo tipo de fallo silencioso que este\n// cambio pretende eliminar, solo que en el campo 'documento' en vez de 'pagina'.\n// itemMatching(i) sigue la cadena real de pairedItem para el item i.\nconst items = $input.all();\nconst out = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const documento = $('Separar Archivos (1 item por PDF)').itemMatching(i).json.documento;\n\n  // Defensivo: la forma esperada de text es un array (una entrada por página). Si\n  // alguien reactiva joinPages en la UI, text vuelve a ser un string único; se trata\n  // como una sola página en vez de iterar carácter a carácter (que es lo que pasaría\n  // con un for..of sobre un string) o reventar.\n  let paginas = items[i].json.text;\n  if (typeof paginas === 'string') paginas = [paginas];\n  if (!Array.isArray(paginas)) paginas = [];\n\n  for (let p = 0; p < paginas.length; p++) {\n    const texto = typeof paginas[p] === 'string' ? paginas[p] : '';\n    // Salta páginas vacías o solo-espacios: no genera chunk que luego se embeba.\n    // OJO: 'pagina' es p + 1, la posición real en el array — si se salta una página\n    // en blanco NO se recompacta la numeración de las siguientes.\n    if (texto.trim() === '') continue;\n\n    out.push({\n      json: { documento, pagina: p + 1, texto },\n      pairedItem: { item: i },\n    });\n  }\n}\n\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "id": "set-metadata",
      "name": "Añade Metadata {documento,pagina}"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH del AS (DELETE FROM documentos_despacho WHERE metadata->>'documento' = $1 RETURNING 1) SELECT $1::text AS documento, $2::int AS pagina, $3::text AS texto",
        "options": {
          "queryReplacement": "={{ [$json.documento, $json.pagina, $json.texto] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
